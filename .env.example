# Jeton unique d'authentification. Laissez vide au premier démarrage : un jeton
# est tiré au hasard, conservé à côté de la base et affiché dans les journaux.
#   docker compose logs turi-kout | grep -A2 "Jeton genere"
AUTH_TOKEN=

# Port exposé sur l'hôte, et interface d'écoute. Par défaut la boucle locale :
# mettez un reverse proxy devant plutôt que d'ouvrir le port.
HOST_PORT=8080
BIND_ADDR=127.0.0.1

LOG_LEVEL=info
