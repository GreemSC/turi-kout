{
  "name": "turi-kout-server",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/index.js && node scripts/postbuild.mjs",
    "start": "node dist/index.js",
    "seed": "node --experimental-strip-types src/seed-cli.ts",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.1.1",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.3"
  },
  "license": "MIT"
}
